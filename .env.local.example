# PostHog (EU region)
# Copy this file to .env.local and fill in your project key.
# These are inlined at build time (NEXT_PUBLIC_*), so they ship to the client.

NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional: site origin used for canonical/OG URLs (defaults to korean-astrology-guide.pages.dev)
# NEXT_PUBLIC_SITE_URL=https://korean-astrology-guide.pages.dev

# Google AdSense publisher ID
NEXT_PUBLIC_ADSENSE_ID=ca-pub-3758936086172142
